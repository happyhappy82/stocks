---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import KeyboardShortcuts from '../../components/KeyboardShortcuts.astro';

const title = "SCHD 배당금 계산기";
const description = "SCHD ETF 배당금을 간편하게 계산하세요. 투자금액 또는 보유 주수를 입력하면 연간·분기·월별 예상 배당금과 미국 원천징수세(15%), 원화 환산 금액까지 자동으로 계산해드립니다. Schwab U.S. Dividend Equity ETF의 배당 수익을 미리 확인하세요.";
const canonicalUrl = "https://www.stocktipguide.xyz/calculators/schd-배당금-계산기";

const faqItems = [
  {
    question: "SCHD는 어떤 종목으로 구성되어 있나요?",
    answer: "SCHD는 고배당 우량주 약 100개로 구성되어 있습니다. 주요 상위 종목으로는 Broadcom(반도체), AbbVie(제약), Merck(제약), Home Depot(유통), Coca-Cola(음료), PepsiCo(식음료), Pfizer(제약), Amgen(바이오) 등이 포함됩니다. 배당 성장성과 재무 건전성을 기준으로 선별되어 안정적인 배당 포트폴리오를 구성합니다."
  },
  {
    question: "SCHD 배당금은 언제 입금되나요?",
    answer: "SCHD는 분기별로 배당금을 지급하며, 배당락일(Ex-Dividend Date) 이후 약 2~3일 뒤 미국 증권사 계좌에 입금됩니다. 한국 증권사를 통해 투자한 경우 추가로 1~2일 정도 소요될 수 있습니다. 일반적으로 배당락일은 3월, 6월, 9월, 12월 말에 설정됩니다."
  },
  {
    question: "SCHD에 매월 적립식으로 투자해도 되나요?",
    answer: "네, SCHD는 적립식 투자에 매우 적합한 ETF입니다. 낮은 운용보수(0.06%), 안정적인 배당 성장, 우량주 중심 구성으로 장기 투자에 유리합니다. 매월 일정 금액을 투자하면 주가 변동성을 평준화(Dollar Cost Averaging)할 수 있고, 배당금 재투자로 복리 효과를 누릴 수 있습니다."
  },
  {
    question: "SCHD 배당금에 세금은 어떻게 부과되나요?",
    answer: "SCHD 배당금에는 미국 원천징수세 15%가 자동으로 공제됩니다. 한국에서는 배당소득세 15.4% 중 미국에서 이미 납부한 15%를 차감하고 0.4%만 추가 납부합니다(연간 금융소득 2,000만 원 이하 기준). 금융소득이 2,000만 원을 초과하면 종합소득세 신고 대상이 됩니다. W-8BEN 양식 제출이 필수입니다."
  },
  {
    question: "SCHD와 SCHD 배당 재투자 중 어떤 게 좋나요?",
    answer: "배당 재투자는 투자 목표에 따라 선택할 수 있습니다. DRIP(Dividend Reinvestment Plan)을 설정하면 배당금이 자동으로 SCHD에 재투자되어 복리 효과를 극대화할 수 있습니다. 현금 흐름이 필요한 경우 배당금을 직접 수령하는 것이 좋습니다. 일부 증권사는 DRIP 설정 시 수수료가 면제되므로, 장기 자산 증식이 목표라면 재투자가 유리합니다."
  }
];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": title,
  "description": description,
  "url": canonicalUrl,
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "Web",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "KRW"
  },
  "author": {
    "@type": "Organization",
    "name": "주식팁가이드",
    "url": "https://www.stocktipguide.xyz"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
>
  <div class="max-w-2xl mx-auto">
    <Header />
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <div class="mb-8">
      <h1 class="text-[42px] font-black leading-tight mb-4">
        {title}
      </h1>
      <p class="text-gray-600 leading-relaxed">
        SCHD ETF 투자금액이나 보유 주수를 입력하면 예상 배당금을 바로 확인할 수 있습니다.
      </p>
    </div>

    <!-- 계산기 -->
    <div class="bg-gray-50 rounded-2xl p-6 mb-12 border border-gray-200">
      <!-- 투자 방식 선택 -->
      <div class="mb-6">
        <label class="block text-sm font-semibold text-gray-700 mb-3">투자 방식 선택</label>
        <div class="flex gap-4">
          <label class="flex items-center cursor-pointer">
            <input
              type="radio"
              name="inputMode"
              value="amount"
              checked
              class="w-4 h-4 text-blue-600 border-gray-300 focus:ring-blue-500"
            />
            <span class="ml-2 text-gray-700">금액으로 입력</span>
          </label>
          <label class="flex items-center cursor-pointer">
            <input
              type="radio"
              name="inputMode"
              value="shares"
              class="w-4 h-4 text-blue-600 border-gray-300 focus:ring-blue-500"
            />
            <span class="ml-2 text-gray-700">주수로 입력</span>
          </label>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
        <!-- 투자금액 입력 (금액 모드) -->
        <div id="amountInput">
          <label for="investmentAmount" class="block text-sm font-semibold text-gray-700 mb-1.5">투자금액 (USD)</label>
          <input
            type="number"
            id="investmentAmount"
            placeholder="예: 10000"
            step="0.01"
            min="0"
            class="w-full px-4 py-3 border border-gray-300 rounded-xl text-base focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white"
          />
        </div>

        <!-- 보유 주수 입력 (주수 모드) -->
        <div id="sharesInput" class="hidden">
          <label for="shares" class="block text-sm font-semibold text-gray-700 mb-1.5">보유 주수</label>
          <input
            type="number"
            id="shares"
            placeholder="예: 100"
            step="1"
            min="0"
            class="w-full px-4 py-3 border border-gray-300 rounded-xl text-base focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white"
          />
        </div>

        <div>
          <label for="stockPrice" class="block text-sm font-semibold text-gray-700 mb-1.5">SCHD 현재 주가 (USD)</label>
          <input
            type="number"
            id="stockPrice"
            placeholder="예: 28.50"
            step="0.01"
            min="0"
            value="28.50"
            class="w-full px-4 py-3 border border-gray-300 rounded-xl text-base focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white"
          />
        </div>
        <div>
          <label for="dividendYield" class="block text-sm font-semibold text-gray-700 mb-1.5">연간 배당률 (%)</label>
          <input
            type="number"
            id="dividendYield"
            placeholder="예: 3.50"
            step="0.01"
            min="0"
            max="100"
            value="3.50"
            class="w-full px-4 py-3 border border-gray-300 rounded-xl text-base focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white"
          />
        </div>
        <div>
          <label for="exchangeRate" class="block text-sm font-semibold text-gray-700 mb-1.5">환율 (KRW/USD)</label>
          <input
            type="number"
            id="exchangeRate"
            placeholder="예: 1450"
            step="1"
            min="0"
            value="1450"
            class="w-full px-4 py-3 border border-gray-300 rounded-xl text-base focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white"
          />
        </div>
      </div>

      <button
        id="calcBtn"
        class="w-full py-3.5 bg-blue-600 text-white font-semibold rounded-xl hover:bg-blue-700 transition-colors text-base flex items-center justify-center gap-2"
      >
        계산하기
        <kbd class="hidden sm:inline-flex px-1.5 py-0.5 bg-blue-500/50 border border-blue-400/30 rounded text-xs font-mono">Ctrl+Enter</kbd>
      </button>

      <!-- 결과 -->
      <div id="result" class="hidden mt-6">
        <div class="h-px bg-gray-200 mb-6"></div>
        <h2 class="text-lg font-bold mb-4">계산 결과</h2>

        <div class="space-y-3">
          <!-- 세전 배당금 -->
          <div class="bg-white rounded-xl p-4 border border-gray-100">
            <p class="text-sm text-gray-500 mb-1">세전 연간 배당금</p>
            <div class="flex items-baseline gap-2">
              <span id="annualDiv" class="text-2xl font-bold text-gray-900">$0.00</span>
              <span id="annualDivKrw" class="text-sm text-gray-500"></span>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div class="bg-white rounded-xl p-4 border border-gray-100">
              <p class="text-sm text-gray-500 mb-1">분기 배당금</p>
              <span id="quarterlyDiv" class="text-lg font-bold text-gray-900">$0.00</span>
              <span id="quarterlyDivKrw" class="block text-sm text-gray-500"></span>
            </div>
            <div class="bg-white rounded-xl p-4 border border-gray-100">
              <p class="text-sm text-gray-500 mb-1">월 환산 배당금</p>
              <span id="monthlyDiv" class="text-lg font-bold text-gray-900">$0.00</span>
              <span id="monthlyDivKrw" class="block text-sm text-gray-500"></span>
            </div>
          </div>

          <!-- 세금 -->
          <div class="bg-red-50 rounded-xl p-4 border border-red-100">
            <p class="text-sm text-red-600 font-semibold mb-1">미국 원천징수세 (15%)</p>
            <span id="taxAmount" class="text-lg font-bold text-red-700">-$0.00</span>
            <span id="taxAmountKrw" class="text-sm text-red-500 ml-2"></span>
          </div>

          <!-- 세후 실수령 (USD) -->
          <div class="bg-blue-50 rounded-xl p-4 border border-blue-100">
            <p class="text-sm text-blue-600 font-semibold mb-2">세후 실수령액 (USD)</p>
            <div class="flex items-baseline gap-2 mb-2">
              <span id="afterTaxAnnual" class="text-2xl font-bold text-blue-700">$0.00</span>
              <span class="text-sm text-blue-500">/ 년</span>
            </div>
            <div class="grid grid-cols-2 gap-2">
              <div>
                <p class="text-xs text-blue-500">분기</p>
                <span id="afterTaxQuarterly" class="text-base font-semibold text-blue-700">$0.00</span>
              </div>
              <div>
                <p class="text-xs text-blue-500">월 환산</p>
                <span id="afterTaxMonthly" class="text-base font-semibold text-blue-700">$0.00</span>
              </div>
            </div>
          </div>

          <!-- 원화 세후 실수령 -->
          <div class="bg-green-50 rounded-xl p-4 border border-green-100">
            <p class="text-sm text-green-600 font-semibold mb-2">원화 환산 세후 실수령액</p>
            <div class="flex items-baseline gap-2 mb-2">
              <span id="krwAnnual" class="text-2xl font-bold text-green-700">0원</span>
              <span class="text-sm text-green-500">/ 년</span>
            </div>
            <div class="grid grid-cols-2 gap-2">
              <div>
                <p class="text-xs text-green-500">분기</p>
                <span id="krwQuarterly" class="text-base font-semibold text-green-700">0원</span>
              </div>
              <div>
                <p class="text-xs text-green-500">월 환산</p>
                <span id="krwMonthly" class="text-base font-semibold text-green-700">0원</span>
              </div>
            </div>
          </div>
        </div>

        <!-- 투자 요약 -->
        <div class="mt-4 bg-white rounded-xl p-4 border border-gray-100">
          <p class="text-sm font-semibold text-gray-700 mb-2">투자 요약</p>
          <div class="grid grid-cols-2 gap-y-2 text-sm">
            <span class="text-gray-500">총 투자금액</span>
            <span id="totalInvestment" class="text-right font-medium text-gray-900">$0.00</span>
            <span class="text-gray-500">총 투자금액 (원화)</span>
            <span id="totalInvestmentKrw" class="text-right font-medium text-gray-900">0원</span>
            <span class="text-gray-500">예상 보유 주수</span>
            <span id="estimatedShares" class="text-right font-medium text-gray-900">0주</span>
            <span class="text-gray-500">세전 배당 수익률</span>
            <span id="yieldDisplay" class="text-right font-medium text-gray-900">0%</span>
            <span class="text-gray-500">세후 배당 수익률</span>
            <span id="afterTaxYield" class="text-right font-medium text-gray-900">0%</span>
          </div>
        </div>
      </div>
    </div>

    <!-- SEO 콘텐츠 -->
    <div class="prose prose-lg max-w-none">
      <h2>SCHD ETF란?</h2>
      <p>
        <strong>SCHD(Schwab U.S. Dividend Equity ETF)</strong>는 Charles Schwab이 운용하는 미국 고배당 ETF로,
        <strong>Dow Jones U.S. Dividend 100 Index</strong>를 추종합니다.
        이 지수는 배당 성장성과 재무 건전성을 기준으로 선별된 약 100개의 미국 우량 배당주로 구성되어 있습니다.
      </p>
      <p>
        SCHD는 단순히 배당률이 높은 종목이 아닌, <strong>지속적으로 배당을 늘려온 기업</strong>에 집중 투자합니다.
        운용보수가 0.06%로 매우 낮고, 장기 배당 성장률이 우수해 배당 투자자들에게 인기가 많습니다.
      </p>

      <h2>SCHD 배당금 지급 일정</h2>
      <p>
        SCHD는 <strong>분기별 배당</strong>을 지급하며, 일반적으로 3월, 6월, 9월, 12월에 배당금이 입금됩니다.
      </p>
      <table>
        <thead>
          <tr>
            <th>항목</th>
            <th>설명</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>배당 주기</td>
            <td>분기별 (연 4회)</td>
          </tr>
          <tr>
            <td>배당락일</td>
            <td>3월, 6월, 9월, 12월 말 (대략 분기 마지막 거래일)</td>
          </tr>
          <tr>
            <td>배당 지급일</td>
            <td>배당락일 이후 약 2주 뒤</td>
          </tr>
          <tr>
            <td>입금 시기</td>
            <td>미국 증권사: 지급일 당일, 한국 증권사: 1~2일 추가 소요</td>
          </tr>
        </tbody>
      </table>
      <p>
        배당을 받으려면 <strong>배당락일(Ex-Dividend Date) 이전</strong>에 주식을 보유하고 있어야 합니다.
        배당락일에 매수하면 해당 배당은 받을 수 없으므로 주의하세요.
      </p>

      <h2>SCHD 배당 이력</h2>
      <p>
        SCHD는 꾸준히 배당금을 늘려왔습니다. 최근 5년간 배당 이력은 다음과 같습니다:
      </p>
      <table>
        <thead>
          <tr>
            <th>연도</th>
            <th>연간 배당금 (주당)</th>
            <th>전년 대비 증가율</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>2020</td>
            <td>$2.0284</td>
            <td>-</td>
          </tr>
          <tr>
            <td>2021</td>
            <td>$2.2495</td>
            <td>+10.9%</td>
          </tr>
          <tr>
            <td>2022</td>
            <td>$2.5614</td>
            <td>+13.9%</td>
          </tr>
          <tr>
            <td>2023</td>
            <td>$2.6606</td>
            <td>+3.9%</td>
          </tr>
          <tr>
            <td>2024</td>
            <td>$2.8193</td>
            <td>+6.0%</td>
          </tr>
        </tbody>
      </table>
      <p>
        <em>* 배당금은 참고용이며, 실제 배당금은 시장 상황에 따라 변동될 수 있습니다.</em>
      </p>

      <h2>SCHD vs 다른 배당 ETF 비교</h2>
      <p>
        SCHD를 다른 인기 배당 ETF와 비교하면 다음과 같습니다:
      </p>
      <table>
        <thead>
          <tr>
            <th>ETF</th>
            <th>배당률 (참고)</th>
            <th>운용보수</th>
            <th>특징</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>SCHD</strong></td>
            <td>약 3.5%</td>
            <td>0.06%</td>
            <td>배당 성장 중심, 우량주 100개, 분기 배당</td>
          </tr>
          <tr>
            <td>VYM</td>
            <td>약 2.8%</td>
            <td>0.06%</td>
            <td>고배당 대형주 400개 이상, 분산 투자</td>
          </tr>
          <tr>
            <td>HDV</td>
            <td>약 3.8%</td>
            <td>0.08%</td>
            <td>재무 건전성 중심, 75개 종목, 분기 배당</td>
          </tr>
          <tr>
            <td>JEPI</td>
            <td>약 7.0%</td>
            <td>0.35%</td>
            <td>커버드콜 전략, 월배당, 높은 배당률</td>
          </tr>
        </tbody>
      </table>
      <p>
        SCHD는 <strong>배당 성장률과 운용보수 측면에서 균형</strong>이 잘 잡혀 있어,
        장기 배당 투자자에게 적합합니다. JEPI는 배당률이 높지만 커버드콜 전략으로 인해
        주가 상승 여력이 제한될 수 있습니다.
      </p>

      <h2>SCHD 투자 시 유의사항</h2>
      <ul>
        <li>
          <strong>배당 성장률</strong>: SCHD는 배당 성장에 초점을 맞추므로,
          단기 배당률보다 장기 배당 증가율이 중요합니다.
          10년 이상 장기 보유 시 복리 효과로 실질 배당률이 크게 상승할 수 있습니다.
        </li>
        <li>
          <strong>운용보수</strong>: 연 0.06%로 매우 낮은 수준입니다.
          장기 투자 시 운용보수 차이가 누적 수익률에 큰 영향을 미치므로,
          SCHD는 비용 측면에서도 매력적입니다.
        </li>
        <li>
          <strong>분산투자 효과</strong>: 약 100개 종목에 분산 투자되어 있어
          개별 기업 리스크가 낮습니다. 다만 미국 시장에만 투자되므로,
          글로벌 분산을 원한다면 해외 ETF를 추가로 고려하세요.
        </li>
        <li>
          <strong>환율 리스크</strong>: 배당금은 달러로 지급되므로 환율 변동에 따라
          원화 기준 수익이 달라질 수 있습니다. 달러 자산으로 보유하거나,
          환율 헤지 전략을 고려할 수 있습니다.
        </li>
        <li>
          <strong>배당 재투자</strong>: DRIP(Dividend Reinvestment Plan)을 활용하면
          배당금을 자동으로 재투자하여 복리 효과를 극대화할 수 있습니다.
          장기 자산 증식이 목표라면 재투자를 추천합니다.
        </li>
      </ul>
    </div>

    <!-- FAQ -->
    <div class="mt-12 mb-8">
      <h2 class="text-2xl font-bold mb-6">자주 묻는 질문</h2>
      <div class="space-y-3">
        {faqItems.map((item) => (
          <details class="group bg-gray-50 rounded-xl border border-gray-200">
            <summary class="flex justify-between items-center cursor-pointer p-4 font-semibold text-gray-900 list-none">
              <span>{item.question}</span>
              <svg class="w-5 h-5 text-gray-500 transition-transform group-open:rotate-180 flex-shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-4 pb-4 text-gray-700 leading-relaxed">
              {item.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
    <KeyboardShortcuts />
  </div>
</Layout>

<script>
  function formatUsd(num: number): string {
    return '$' + num.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function formatKrw(num: number): string {
    return Math.round(num).toLocaleString('ko-KR') + '원';
  }

  function toggleInputMode() {
    const mode = (document.querySelector('input[name="inputMode"]:checked') as HTMLInputElement)?.value || 'amount';
    const amountInput = document.getElementById('amountInput');
    const sharesInput = document.getElementById('sharesInput');

    if (mode === 'amount') {
      amountInput?.classList.remove('hidden');
      sharesInput?.classList.add('hidden');
    } else {
      amountInput?.classList.add('hidden');
      sharesInput?.classList.remove('hidden');
    }
  }

  function calculate() {
    const mode = (document.querySelector('input[name="inputMode"]:checked') as HTMLInputElement)?.value || 'amount';
    const stockPrice = parseFloat((document.getElementById('stockPrice') as HTMLInputElement).value) || 0;
    const dividendYield = parseFloat((document.getElementById('dividendYield') as HTMLInputElement).value) || 0;
    const exchangeRate = parseFloat((document.getElementById('exchangeRate') as HTMLInputElement).value) || 1450;

    let shares = 0;
    let totalInvestment = 0;

    if (mode === 'amount') {
      const investmentAmount = parseFloat((document.getElementById('investmentAmount') as HTMLInputElement).value) || 0;
      if (investmentAmount <= 0 || stockPrice <= 0) {
        return;
      }
      shares = investmentAmount / stockPrice;
      totalInvestment = investmentAmount;
    } else {
      shares = parseFloat((document.getElementById('shares') as HTMLInputElement).value) || 0;
      if (shares <= 0 || stockPrice <= 0) {
        return;
      }
      totalInvestment = stockPrice * shares;
    }

    if (dividendYield <= 0) {
      return;
    }

    const annualDividend = totalInvestment * (dividendYield / 100);
    const quarterlyDividend = annualDividend / 4;
    const monthlyDividend = annualDividend / 12;

    const taxRate = 0.15;
    const taxAmount = annualDividend * taxRate;

    const afterTaxAnnual = annualDividend - taxAmount;
    const afterTaxQuarterly = afterTaxAnnual / 4;
    const afterTaxMonthly = afterTaxAnnual / 12;

    const afterTaxYield = dividendYield * (1 - taxRate);

    // 결과 표시
    const resultEl = document.getElementById('result');
    if (resultEl) resultEl.classList.remove('hidden');

    // 세전 배당금
    const setTextContent = (id: string, text: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = text;
    };

    setTextContent('annualDiv', formatUsd(annualDividend));
    setTextContent('annualDivKrw', formatKrw(annualDividend * exchangeRate));
    setTextContent('quarterlyDiv', formatUsd(quarterlyDividend));
    setTextContent('quarterlyDivKrw', formatKrw(quarterlyDividend * exchangeRate));
    setTextContent('monthlyDiv', formatUsd(monthlyDividend));
    setTextContent('monthlyDivKrw', formatKrw(monthlyDividend * exchangeRate));

    // 세금
    setTextContent('taxAmount', '-' + formatUsd(taxAmount));
    setTextContent('taxAmountKrw', '-' + formatKrw(taxAmount * exchangeRate));

    // 세후 실수령 (USD)
    setTextContent('afterTaxAnnual', formatUsd(afterTaxAnnual));
    setTextContent('afterTaxQuarterly', formatUsd(afterTaxQuarterly));
    setTextContent('afterTaxMonthly', formatUsd(afterTaxMonthly));

    // 원화 세후 실수령
    setTextContent('krwAnnual', formatKrw(afterTaxAnnual * exchangeRate));
    setTextContent('krwQuarterly', formatKrw(afterTaxQuarterly * exchangeRate));
    setTextContent('krwMonthly', formatKrw(afterTaxMonthly * exchangeRate));

    // 투자 요약
    setTextContent('totalInvestment', formatUsd(totalInvestment));
    setTextContent('totalInvestmentKrw', formatKrw(totalInvestment * exchangeRate));
    setTextContent('estimatedShares', shares.toFixed(2) + '주');
    setTextContent('yieldDisplay', dividendYield.toFixed(2) + '%');
    setTextContent('afterTaxYield', afterTaxYield.toFixed(2) + '%');
  }

  // 이벤트 리스너 설정
  document.querySelectorAll('input[name="inputMode"]').forEach(radio => {
    radio.addEventListener('change', toggleInputMode);
  });

  document.getElementById('calcBtn')?.addEventListener('click', calculate);

  // Enter 키로도 계산
  document.querySelectorAll('input[type="number"]').forEach(input => {
    input.addEventListener('keypress', (e: Event) => {
      if ((e as KeyboardEvent).key === 'Enter') calculate();
    });
  });

  // 페이지 로드 시 초기 모드 설정
  toggleInputMode();
</script>
