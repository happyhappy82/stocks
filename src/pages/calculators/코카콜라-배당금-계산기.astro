---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';

const title = "코카콜라 배당금 계산기";
const description = "코카콜라(KO) 주식 배당금을 계산하세요. 보유 주수를 입력하면 연간·분기·월별 예상 배당금, 미국 원천징수세(15%), 원화 환산 실수령액까지 자동으로 계산해드립니다. 62년 연속 배당 인상 기록의 배당킹 코카콜라 투자 정보를 확인하세요.";
const canonicalUrl = "https://www.stocktipguide.xyz/calculators/코카콜라-배당금-계산기";

const faqItems = [
  {
    question: "코카콜라 배당금은 언제 받을 수 있나요?",
    answer: "코카콜라는 분기 배당을 지급하며, 보통 4월, 7월, 10월, 12월에 배당금이 지급됩니다. 배당금을 받으려면 배당락일(Ex-Dividend Date) 전에 주식을 보유하고 있어야 합니다. 배당락일은 보통 배당 기준일 1~2영업일 전이며, 배당 지급일은 배당 기준일로부터 약 2~3주 후입니다."
  },
  {
    question: "코카콜라는 왜 배당킹이라고 불리나요?",
    answer: "코카콜라는 62년 연속 배당금을 인상한 기록을 가지고 있어 '배당킹(Dividend King)' 타이틀을 보유하고 있습니다. 배당킹은 50년 이상 연속으로 배당금을 인상한 기업을 지칭하며, 미국 시장에서도 매우 소수의 기업만이 이 타이틀을 유지하고 있습니다. 이는 코카콜라의 안정적인 현금흐름과 주주환원 정책을 보여주는 증거입니다."
  },
  {
    question: "코카콜라 배당금으로 월 100만 원 받으려면?",
    answer: "2024년 기준 코카콜라 주가 $63, 연간 주당 배당금 $1.94, 환율 1,450원으로 계산하면 세후 월 100만 원을 받으려면 약 519주가 필요합니다. 총 투자금은 약 $32,697(약 4,740만 원)입니다. 세후 연간 배당금은 약 $857(약 1,243만 원), 월 환산 약 $71(약 103만 원)을 받게 됩니다."
  },
  {
    question: "코카콜라 주식은 안전한 투자인가요?",
    answer: "코카콜라는 전 세계 200개국 이상에서 판매되는 대표적인 경기방어주(Defensive Stock)입니다. 경기 침체기에도 안정적인 현금흐름을 유지하며, 62년 연속 배당 인상 기록이 이를 증명합니다. 다만 최근 건강 음료 트렌드로 인한 탄산음료 소비 감소, 설탕세 도입, 경쟁 심화 등의 리스크가 있으므로 분산 투자가 중요합니다."
  },
  {
    question: "코카콜라 배당 성장률은 어느 정도인가요?",
    answer: "코카콜라의 최근 5년(2019~2024) 평균 배당 성장률은 약 3~4%입니다. 2019년 $1.60에서 2024년 $1.94로 꾸준히 증가했습니다. 비록 고배당주는 아니지만, 안정적인 배당 성장과 배당킹 타이틀을 유지하며 장기 투자자에게 매력적인 종목입니다. 배당 재투자 시 복리 효과로 더 큰 수익을 기대할 수 있습니다."
  }
];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": title,
  "description": description,
  "url": canonicalUrl,
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "Web",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "KRW"
  },
  "author": {
    "@type": "Organization",
    "name": "주식팁가이드",
    "url": "https://www.stocktipguide.xyz"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
>
  <div class="max-w-2xl mx-auto">
    <Header />
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <div class="mb-8">
      <h1 class="text-[42px] font-black leading-tight mb-4">
        {title}
      </h1>
      <p class="text-gray-600 leading-relaxed">
        62년 연속 배당 인상 기록의 배당킹 코카콜라(KO). 투자금액이나 보유 주수를 입력하면 예상 배당금을 바로 확인할 수 있습니다.
      </p>
    </div>

    <!-- 계산기 -->
    <div class="bg-gray-50 rounded-2xl p-6 mb-12 border border-gray-200">
      <!-- 투자 방식 선택 -->
      <div class="mb-6">
        <label class="block text-sm font-semibold text-gray-700 mb-3">투자 방식 선택</label>
        <div class="flex gap-4">
          <label class="flex items-center cursor-pointer">
            <input
              type="radio"
              name="inputMode"
              value="amount"
              checked
              class="w-4 h-4 text-blue-600 focus:ring-blue-500 focus:ring-2"
            />
            <span class="ml-2 text-sm font-medium text-gray-700">금액으로 입력</span>
          </label>
          <label class="flex items-center cursor-pointer">
            <input
              type="radio"
              name="inputMode"
              value="shares"
              class="w-4 h-4 text-blue-600 focus:ring-blue-500 focus:ring-2"
            />
            <span class="ml-2 text-sm font-medium text-gray-700">주수로 입력</span>
          </label>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
        <!-- 투자금액 입력 -->
        <div id="amountInput">
          <label for="investmentAmount" class="block text-sm font-semibold text-gray-700 mb-1.5">투자금액 (USD)</label>
          <input
            type="number"
            id="investmentAmount"
            placeholder="예: 10000"
            step="100"
            min="0"
            class="w-full px-4 py-3 border border-gray-300 rounded-xl text-base focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white"
          />
        </div>

        <!-- 보유 주수 입력 -->
        <div id="sharesInput" class="hidden">
          <label for="shares" class="block text-sm font-semibold text-gray-700 mb-1.5">보유 주수</label>
          <input
            type="number"
            id="shares"
            placeholder="예: 100"
            step="1"
            min="0"
            class="w-full px-4 py-3 border border-gray-300 rounded-xl text-base focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white"
          />
        </div>

        <div>
          <label for="stockPrice" class="block text-sm font-semibold text-gray-700 mb-1.5">코카콜라 현재 주가 (USD)</label>
          <input
            type="number"
            id="stockPrice"
            placeholder="예: 63.00"
            step="0.01"
            min="0"
            value="63.00"
            class="w-full px-4 py-3 border border-gray-300 rounded-xl text-base focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white"
          />
        </div>
        <div>
          <label for="annualDividend" class="block text-sm font-semibold text-gray-700 mb-1.5">연간 주당 배당금 (USD)</label>
          <input
            type="number"
            id="annualDividend"
            placeholder="예: 1.94"
            step="0.01"
            min="0"
            value="1.94"
            class="w-full px-4 py-3 border border-gray-300 rounded-xl text-base focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white"
          />
        </div>
        <div>
          <label for="exchangeRate" class="block text-sm font-semibold text-gray-700 mb-1.5">환율 (KRW/USD)</label>
          <input
            type="number"
            id="exchangeRate"
            placeholder="예: 1450"
            step="1"
            min="0"
            value="1450"
            class="w-full px-4 py-3 border border-gray-300 rounded-xl text-base focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white"
          />
        </div>
      </div>

      <button
        id="calcBtn"
        class="w-full py-3.5 bg-blue-600 text-white font-semibold rounded-xl hover:bg-blue-700 transition-colors text-base"
      >
        계산하기
      </button>

      <!-- 결과 -->
      <div id="result" class="hidden mt-6">
        <div class="h-px bg-gray-200 mb-6"></div>
        <h2 class="text-lg font-bold mb-4">계산 결과</h2>

        <div class="space-y-3">
          <!-- 배당률 표시 -->
          <div class="bg-purple-50 rounded-xl p-4 border border-purple-100">
            <p class="text-sm text-purple-600 font-semibold mb-1">코카콜라 배당률</p>
            <span id="dividendYieldDisplay" class="text-2xl font-bold text-purple-700">0.00%</span>
          </div>

          <!-- 세전 배당금 -->
          <div class="bg-white rounded-xl p-4 border border-gray-100">
            <p class="text-sm text-gray-500 mb-1">세전 연간 배당금</p>
            <div class="flex items-baseline gap-2">
              <span id="annualDiv" class="text-2xl font-bold text-gray-900">$0.00</span>
              <span id="annualDivKrw" class="text-sm text-gray-500"></span>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div class="bg-white rounded-xl p-4 border border-gray-100">
              <p class="text-sm text-gray-500 mb-1">분기 배당금</p>
              <span id="quarterlyDiv" class="text-lg font-bold text-gray-900">$0.00</span>
              <span id="quarterlyDivKrw" class="block text-sm text-gray-500"></span>
            </div>
            <div class="bg-white rounded-xl p-4 border border-gray-100">
              <p class="text-sm text-gray-500 mb-1">월 환산 배당금</p>
              <span id="monthlyDiv" class="text-lg font-bold text-gray-900">$0.00</span>
              <span id="monthlyDivKrw" class="block text-sm text-gray-500"></span>
            </div>
          </div>

          <!-- 세금 -->
          <div class="bg-red-50 rounded-xl p-4 border border-red-100">
            <p class="text-sm text-red-600 font-semibold mb-1">미국 원천징수세 (15%)</p>
            <span id="taxAmount" class="text-lg font-bold text-red-700">-$0.00</span>
            <span id="taxAmountKrw" class="text-sm text-red-500 ml-2"></span>
          </div>

          <!-- 세후 실수령 -->
          <div class="bg-blue-50 rounded-xl p-4 border border-blue-100">
            <p class="text-sm text-blue-600 font-semibold mb-2">세후 실수령액</p>
            <div class="flex items-baseline gap-2 mb-2">
              <span id="afterTaxAnnual" class="text-2xl font-bold text-blue-700">$0.00</span>
              <span class="text-sm text-blue-500">/ 년</span>
            </div>
            <div class="grid grid-cols-2 gap-2">
              <div>
                <p class="text-xs text-blue-500">분기</p>
                <span id="afterTaxQuarterly" class="text-base font-semibold text-blue-700">$0.00</span>
              </div>
              <div>
                <p class="text-xs text-blue-500">월 환산</p>
                <span id="afterTaxMonthly" class="text-base font-semibold text-blue-700">$0.00</span>
              </div>
            </div>
          </div>

          <!-- 원화 세후 실수령 -->
          <div class="bg-green-50 rounded-xl p-4 border border-green-100">
            <p class="text-sm text-green-600 font-semibold mb-2">원화 환산 세후 실수령액</p>
            <div class="flex items-baseline gap-2 mb-2">
              <span id="krwAnnual" class="text-2xl font-bold text-green-700">0원</span>
              <span class="text-sm text-green-500">/ 년</span>
            </div>
            <div class="grid grid-cols-2 gap-2">
              <div>
                <p class="text-xs text-green-500">분기</p>
                <span id="krwQuarterly" class="text-base font-semibold text-green-700">0원</span>
              </div>
              <div>
                <p class="text-xs text-green-500">월 환산</p>
                <span id="krwMonthly" class="text-base font-semibold text-green-700">0원</span>
              </div>
            </div>
          </div>
        </div>

        <!-- 투자 요약 -->
        <div class="mt-4 bg-white rounded-xl p-4 border border-gray-100">
          <p class="text-sm font-semibold text-gray-700 mb-2">투자 요약</p>
          <div class="grid grid-cols-2 gap-y-2 text-sm">
            <span class="text-gray-500">총 투자금액</span>
            <span id="totalInvestment" class="text-right font-medium text-gray-900">$0.00</span>
            <span class="text-gray-500">총 투자금액 (원화)</span>
            <span id="totalInvestmentKrw" class="text-right font-medium text-gray-900">0원</span>
            <span class="text-gray-500">보유 주수</span>
            <span id="sharesDisplay" class="text-right font-medium text-gray-900">0주</span>
            <span class="text-gray-500">배당률</span>
            <span id="yieldDisplay" class="text-right font-medium text-gray-900">0%</span>
            <span class="text-gray-500">세전 배당 수익률</span>
            <span id="preTaxYield" class="text-right font-medium text-gray-900">0%</span>
            <span class="text-gray-500">세후 배당 수익률</span>
            <span id="afterTaxYield" class="text-right font-medium text-gray-900">0%</span>
          </div>
        </div>
      </div>
    </div>

    <!-- SEO 콘텐츠 -->
    <div class="prose prose-lg max-w-none">
      <h2>코카콜라(KO) 배당금이란?</h2>
      <p>
        코카콜라(The Coca-Cola Company, 티커: KO)는 전 세계 200개국 이상에서 판매되는 세계 최대 음료 기업입니다.
        코카콜라, 스프라이트, 환타, 미닛메이드 등 다양한 브랜드를 보유하고 있으며,
        <strong>62년 연속 배당금을 인상</strong>한 기록으로 '배당킹(Dividend King)' 타이틀을 보유하고 있습니다.
      </p>
      <p>
        배당킹은 50년 이상 연속으로 배당금을 인상한 기업을 지칭하며, 미국 시장에서도 매우 소수의 기업만이 이 타이틀을 유지하고 있습니다.
        코카콜라는 안정적인 현금흐름과 글로벌 브랜드 파워를 바탕으로 꾸준히 주주들에게 배당금을 지급하고 있으며,
        경기방어주로서 장기 투자자들에게 인기 있는 종목입니다.
      </p>

      <h2>코카콜라 배당금 이력</h2>
      <p>
        코카콜라는 최근 5년간 연평균 약 3~4%의 배당 성장률을 기록하고 있습니다.
        2024년 기준 연간 주당 배당금은 $1.94로, 2019년 $1.60 대비 약 21% 증가했습니다.
      </p>
      <table>
        <thead>
          <tr>
            <th>연도</th>
            <th>연간 주당 배당금</th>
            <th>전년 대비 증가율</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>2019</td>
            <td>$1.60</td>
            <td>-</td>
          </tr>
          <tr>
            <td>2020</td>
            <td>$1.64</td>
            <td>+2.5%</td>
          </tr>
          <tr>
            <td>2021</td>
            <td>$1.68</td>
            <td>+2.4%</td>
          </tr>
          <tr>
            <td>2022</td>
            <td>$1.76</td>
            <td>+4.8%</td>
          </tr>
          <tr>
            <td>2023</td>
            <td>$1.84</td>
            <td>+4.5%</td>
          </tr>
          <tr>
            <td>2024</td>
            <td>$1.94</td>
            <td>+5.4%</td>
          </tr>
        </tbody>
      </table>
      <p>
        * 배당금은 매년 2월경 발표되며, 주가와 시장 상황에 따라 배당률은 변동됩니다.
      </p>

      <h2>코카콜라 배당금 지급 일정</h2>
      <p>
        코카콜라는 <strong>분기 배당</strong>을 지급하며, 보통 4월, 7월, 10월, 12월에 배당금이 지급됩니다.
        배당금을 받으려면 다음 세 가지 날짜를 이해해야 합니다:
      </p>
      <ul>
        <li><strong>배당락일(Ex-Dividend Date)</strong>: 이 날짜 이전에 주식을 보유해야 배당금을 받을 수 있습니다. 배당락일에는 주가가 배당금만큼 하락하는 것이 일반적입니다.</li>
        <li><strong>배당 기준일(Record Date)</strong>: 배당금을 받을 주주를 확정하는 날입니다. 보통 배당락일로부터 1~2영업일 후입니다.</li>
        <li><strong>배당 지급일(Payment Date)</strong>: 실제 배당금이 계좌에 입금되는 날입니다. 보통 배당 기준일로부터 2~3주 후입니다.</li>
      </ul>
      <p>
        예를 들어, 2024년 4월 배당의 경우 배당락일이 3월 14일이었다면, 3월 13일까지 주식을 보유해야 배당금을 받을 수 있으며,
        실제 배당금은 4월 1일에 지급되었습니다.
      </p>

      <h2>코카콜라 vs 펩시코 배당 비교</h2>
      <p>
        코카콜라의 최대 경쟁사인 펩시코(PEP)와 배당 투자 관점에서 비교해보겠습니다.
      </p>
      <table>
        <thead>
          <tr>
            <th>항목</th>
            <th>코카콜라 (KO)</th>
            <th>펩시코 (PEP)</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>현재 주가 (참고)</td>
            <td>$63.00</td>
            <td>$170.00</td>
          </tr>
          <tr>
            <td>연간 주당 배당금</td>
            <td>$1.94</td>
            <td>$5.42</td>
          </tr>
          <tr>
            <td>배당률</td>
            <td>약 3.1%</td>
            <td>약 3.2%</td>
          </tr>
          <tr>
            <td>연속 배당 인상</td>
            <td>62년</td>
            <td>52년</td>
          </tr>
          <tr>
            <td>배당 타이틀</td>
            <td>배당킹</td>
            <td>배당킹</td>
          </tr>
          <tr>
            <td>배당 성향</td>
            <td>약 75%</td>
            <td>약 65%</td>
          </tr>
          <tr>
            <td>5년 평균 배당 성장률</td>
            <td>약 3~4%</td>
            <td>약 5~7%</td>
          </tr>
        </tbody>
      </table>
      <p>
        코카콜라는 펩시코보다 긴 배당 인상 기록을 가지고 있으며, 주가가 상대적으로 낮아 소액 투자자에게 유리합니다.
        반면 펩시코는 스낵 사업(프리토레이, 도리토스 등)을 통해 더 다각화된 수익 구조를 가지고 있으며,
        배당 성장률이 더 높은 편입니다. 두 종목 모두 안정적인 배당주로 평가받고 있습니다.
      </p>

      <h2>코카콜라 배당 투자 전략</h2>
      <p>
        코카콜라에 장기 배당 투자를 고려한다면 다음 전략을 참고하세요:
      </p>

      <h3>1. 장기 보유 전략</h3>
      <p>
        코카콜라는 62년 연속 배당 인상 기록을 가진 배당킹입니다. 단기 주가 변동에 흔들리지 않고
        10년 이상 장기 보유하면 배당 성장과 복리 효과를 누릴 수 있습니다.
        워렌 버핏도 1988년부터 코카콜라를 보유하고 있으며, 현재 매입가 대비 배당률이 50%를 넘는 것으로 알려져 있습니다.
      </p>

      <h3>2. 배당 재투자 전략 (DRIP)</h3>
      <p>
        받은 배당금으로 코카콜라 주식을 추가 매수하면 복리 효과로 보유 주수가 눈덩이처럼 불어납니다.
        많은 증권사에서 자동 배당 재투자 서비스를 제공하므로 활용해보세요.
        예를 들어, 연 3% 배당률로 30년간 배당 재투자 시 원금은 약 2.4배로 증가합니다.
      </p>

      <h3>3. 적립식 매수 전략</h3>
      <p>
        매월 일정 금액으로 코카콜라 주식을 매수하는 적립식 투자는 평균 매입 단가를 낮추는 효과가 있습니다.
        주가가 낮을 때는 더 많은 주식을 매수하고, 주가가 높을 때는 적게 매수하여 리스크를 분산할 수 있습니다.
      </p>

      <h3>4. 배당 성장 모니터링</h3>
      <p>
        코카콜라의 분기별 실적과 배당 발표를 주기적으로 확인하세요.
        배당 성향(Payout Ratio)이 80%를 넘어가면 배당 인상 여력이 줄어들 수 있으므로 주의가 필요합니다.
        현재 코카콜라의 배당 성향은 약 75%로 안정적인 수준입니다.
      </p>

      <h3>5. 세금 최적화</h3>
      <p>
        미국 주식 배당금은 15% 원천징수되며, 한국에서 추가로 세금이 부과될 수 있습니다.
        ISA, 연금저축 등 세제혜택 계좌를 활용하면 세금 부담을 줄일 수 있습니다.
        또한 연간 금융소득 2,000만 원 이하로 관리하면 종합소득세 신고 대상에서 제외됩니다.
      </p>
    </div>

    <!-- FAQ -->
    <div class="mt-12 mb-8">
      <h2 class="text-2xl font-bold mb-6">자주 묻는 질문</h2>
      <div class="space-y-3">
        {faqItems.map((item) => (
          <details class="group bg-gray-50 rounded-xl border border-gray-200">
            <summary class="flex justify-between items-center cursor-pointer p-4 font-semibold text-gray-900 list-none">
              <span>{item.question}</span>
              <svg class="w-5 h-5 text-gray-500 transition-transform group-open:rotate-180 flex-shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-4 pb-4 text-gray-700 leading-relaxed">
              {item.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</Layout>

<script>
  function formatUsd(num: number): string {
    return '$' + num.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function formatKrw(num: number): string {
    return Math.round(num).toLocaleString('ko-KR') + '원';
  }

  function calculate() {
    const inputMode = (document.querySelector('input[name="inputMode"]:checked') as HTMLInputElement)?.value || 'amount';
    const stockPrice = parseFloat((document.getElementById('stockPrice') as HTMLInputElement).value) || 0;
    const annualDividendPerShare = parseFloat((document.getElementById('annualDividend') as HTMLInputElement).value) || 0;
    const exchangeRate = parseFloat((document.getElementById('exchangeRate') as HTMLInputElement).value) || 1450;

    let shares = 0;
    let totalInvestment = 0;

    if (inputMode === 'amount') {
      const investmentAmount = parseFloat((document.getElementById('investmentAmount') as HTMLInputElement).value) || 0;
      if (investmentAmount <= 0 || stockPrice <= 0) return;
      shares = Math.floor(investmentAmount / stockPrice);
      totalInvestment = shares * stockPrice;
    } else {
      shares = parseFloat((document.getElementById('shares') as HTMLInputElement).value) || 0;
      if (shares <= 0 || stockPrice <= 0) return;
      totalInvestment = shares * stockPrice;
    }

    if (shares <= 0 || annualDividendPerShare <= 0) return;

    const dividendYield = (annualDividendPerShare / stockPrice) * 100;
    const annualDividend = shares * annualDividendPerShare;
    const quarterlyDividend = annualDividend / 4;
    const monthlyDividend = annualDividend / 12;

    const taxRate = 0.15;
    const taxAmount = annualDividend * taxRate;

    const afterTaxAnnual = annualDividend - taxAmount;
    const afterTaxQuarterly = afterTaxAnnual / 4;
    const afterTaxMonthly = afterTaxAnnual / 12;

    const preTaxYield = (annualDividend / totalInvestment) * 100;
    const afterTaxYield = (afterTaxAnnual / totalInvestment) * 100;

    // 결과 표시
    const resultEl = document.getElementById('result');
    if (resultEl) resultEl.classList.remove('hidden');

    const setTextContent = (id: string, text: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = text;
    };

    // 배당률
    setTextContent('dividendYieldDisplay', dividendYield.toFixed(2) + '%');

    // 세전 배당금
    setTextContent('annualDiv', formatUsd(annualDividend));
    setTextContent('annualDivKrw', formatKrw(annualDividend * exchangeRate));
    setTextContent('quarterlyDiv', formatUsd(quarterlyDividend));
    setTextContent('quarterlyDivKrw', formatKrw(quarterlyDividend * exchangeRate));
    setTextContent('monthlyDiv', formatUsd(monthlyDividend));
    setTextContent('monthlyDivKrw', formatKrw(monthlyDividend * exchangeRate));

    // 세금
    setTextContent('taxAmount', '-' + formatUsd(taxAmount));
    setTextContent('taxAmountKrw', '-' + formatKrw(taxAmount * exchangeRate));

    // 세후 실수령 (USD)
    setTextContent('afterTaxAnnual', formatUsd(afterTaxAnnual));
    setTextContent('afterTaxQuarterly', formatUsd(afterTaxQuarterly));
    setTextContent('afterTaxMonthly', formatUsd(afterTaxMonthly));

    // 원화 세후 실수령
    setTextContent('krwAnnual', formatKrw(afterTaxAnnual * exchangeRate));
    setTextContent('krwQuarterly', formatKrw(afterTaxQuarterly * exchangeRate));
    setTextContent('krwMonthly', formatKrw(afterTaxMonthly * exchangeRate));

    // 투자 요약
    setTextContent('totalInvestment', formatUsd(totalInvestment));
    setTextContent('totalInvestmentKrw', formatKrw(totalInvestment * exchangeRate));
    setTextContent('sharesDisplay', shares.toFixed(0) + '주');
    setTextContent('yieldDisplay', dividendYield.toFixed(2) + '%');
    setTextContent('preTaxYield', preTaxYield.toFixed(2) + '%');
    setTextContent('afterTaxYield', afterTaxYield.toFixed(2) + '%');
  }

  // 투자 방식 선택 라디오 버튼 이벤트
  document.querySelectorAll('input[name="inputMode"]').forEach(radio => {
    radio.addEventListener('change', (e: Event) => {
      const value = (e.target as HTMLInputElement).value;
      const amountInput = document.getElementById('amountInput');
      const sharesInput = document.getElementById('sharesInput');

      if (value === 'amount') {
        amountInput?.classList.remove('hidden');
        sharesInput?.classList.add('hidden');
      } else {
        amountInput?.classList.add('hidden');
        sharesInput?.classList.remove('hidden');
      }
    });
  });

  document.getElementById('calcBtn')?.addEventListener('click', calculate);

  // Enter 키로도 계산
  document.querySelectorAll('input[type="number"]').forEach(input => {
    input.addEventListener('keypress', (e: Event) => {
      if ((e as KeyboardEvent).key === 'Enter') calculate();
    });
  });
</script>
